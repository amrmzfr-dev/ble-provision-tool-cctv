# Copy to .env on the VPS (same directory as docker-compose.prod.yml) and
# fill in real values. docker-compose reads .env automatically. Never commit
# the real .env - it's gitignored.

# Postgres for the mini backend (ble-backend / ble-postgres services)
POSTGRES_DB=ble_provision
POSTGRES_USER=ble_provision
POSTGRES_PASSWORD=

# Signs the login JWTs this app issues - any long random string, e.g. `openssl rand -base64 48`
JWT_SECRET=

# The real camera backend's admin key - this is the ONLY place it lives now.
# Never put it in the frontend build or the browser again.
CCTV_ADMIN_KEY=

# First login account, created automatically on first startup if the Users
# table is empty. Create more accounts afterward via POST /api/auth/users
# while logged in - no separate registration screen.
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
